    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.4",
    "three": "^0.187.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
